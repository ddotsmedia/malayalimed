# MalayaliMed web — Next.js standalone build.
FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /app

# Install deps against the full workspace so pnpm links every workspace
# package's node_modules correctly (apps/web/node_modules included).
FROM base AS build
COPY . .
RUN mkdir -p apps/web/public
RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter @mm/web build

FROM base AS run
ENV NODE_ENV=production
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
